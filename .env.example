# Backend (Express server in server/index.js)
# Copy this file to `.env` (DO NOT commit `.env`) and fill in your own keys.

# Required if you want to use the built-in backend proxy endpoints:
# - POST /api/chat (Groq)
# - POST /api/openrouter/chat (OpenRouter)
GROQ_API_KEY=""
OPENROUTER_API_KEY=""

# Optional OpenRouter metadata (not secrets)
OPENROUTER_HTTP_REFERER="http://localhost:3000"
OPENROUTER_APP_TITLE="NodeUno"


# Frontend (Vite)
# NOTE: Any `VITE_*` value is embedded into the browser bundle (public).
# Use these only for non-secret configuration.

# Backend base URL for the frontend to reach the Express server.
# - In dev, you can leave this as "" and rely on the Vite proxy (/api -> http://localhost:3001)
# - In prod, set it to your deployed backend origin, e.g. https://api.example.com
VITE_BACKEND_URL=""
